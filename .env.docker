# 컨테이너 안에서만 덮어쓰는 값. compose가 .env 다음에 읽어 이 파일이 이긴다.
# 비밀값은 여기 두지 않는다 — 이 파일은 저장소에 커밋된다.
DATABASE_URL=postgresql+asyncpg://news2:news2@db:5432/news2
REDIS_URL=redis://redis:6379/0
# SENTRY_DSN은 비밀값이므로 먼저 읽는 .env에서 주입한다.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=news2@local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ERROR_SAMPLE_RATE=1.0
SLACK_NOTIFICATIONS_ENABLED=false
