# 호스트에서 직접 실행할 때 쓰는 값. compose.local.yaml이 띄운 db·redis의
# 공개 포트를 가리킨다. 컨테이너 안에서 쓰는 값은 .env.docker가 덮어쓴다.
DATABASE_URL=postgresql+asyncpg://news2:news2@localhost:15432/news2
REDIS_URL=redis://localhost:16379/0
LOG_FORMAT=console
LOG_LEVEL=INFO

# 오류 추적. DSN이 비어 있으면 Sentry를 초기화하지 않는다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=news2@local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ERROR_SAMPLE_RATE=1.0

# 운영 이슈와 투자 리포트 Slack 전송. 로컬 기본값은 비활성이다.
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_ISSUES_CHANNEL_ID=
SLACK_REPORTS_CHANNEL_ID=
ISSUE_DIGEST_INTERVAL_SECONDS=3600
ISSUE_EVENT_RETENTION_SECONDS=86400
ISSUE_LLM_PROVIDER=openai
ISSUE_LLM_MODEL=
ISSUE_LLM_TIMEOUT_SECONDS=30
ISSUE_LLM_MAX_GROUPS=20
OPENAI_API_KEY=

KIS_APP_KEY=
KIS_APP_SECRET=

# Real trading
KIS_REST_DOMAIN=https://openapi.koreainvestment.com:9443
KIS_WEBSOCKET_DOMAIN=ws://ops.koreainvestment.com:21000

# Virtual trading
KIS_VIRTUAL_REST_DOMAIN=https://openapivts.koreainvestment.com:29443
KIS_VIRTUAL_WEBSOCKET_DOMAIN=ws://ops.koreainvestment.com:31000

FRED_API_KEY=
